root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.swift]
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

# Two trailing spaces are a Markdown line break.
[*.md]
trim_trailing_whitespace = false

# HL7 messages end each segment with a bare CR; fixtures are kept byte for byte.
[*.hl7]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false

[Tests/Fixtures/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
