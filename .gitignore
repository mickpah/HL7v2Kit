# Generated docs (site/ is the GitHub Pages output of the docs workflow)
docs/DocC/build/
site/
*.doccarchive

# No PDF belongs in this repository. The spec PDFs are licensed content and the
# only PDFs we handle; this is a belt-and-braces rule so a copy dropped outside
# private/ still cannot be committed. No PDF has ever been tracked.
*.pdf
*.PDF

# Everything local to the maintainer lives under private/: the licensed HL7 standards
# (PDFs and XML schema bundles), the planning documents and archive snapshots, the design
# records (audits, sweeps, registers), the maintainer scripts and the release checklist.
# scripts/scan-for-phi.py treats any path under it as licensed content.
private/

# Working notes and assistant settings
the working notes
the editor settings

# Tool-owned local state: the uv virtual environment (just venv), the semantic index,
# the plan workspaces and python caches
.venv/
.zvec-grep/
.superpowers/
__pycache__/
